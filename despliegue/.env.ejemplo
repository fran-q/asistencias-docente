# =============================================================================
#  Plantilla de la configuracion del servidor. NO poner valores reales aca: este
#  archivo esta en un repositorio publico.
#
#  ./generar-secretos.sh la copia como .env y completa los secretos con valores
#  al azar. Despues hay que completar a mano las secciones Dominio y Correo.
#  .env no se versiona.
# =============================================================================

# ---- Dominio ----
# El nombre con el que se entra. Tiene que apuntar a este servidor antes de arrancar:
# sin eso Caddy no puede sacar el certificado.
DOMINIO=COMPLETAR
# A donde avisa Let's Encrypt si un certificado tiene problemas.
CORREO_ACME=COMPLETAR

# ---- Correo saliente ----
# Con STARTTLS: el perfil prod no manda nada sin cifrar. MAIL_FROM tiene que ser de un
# dominio con SPF y DKIM configurados, o los codigos terminan en spam.
MAIL_HOST=COMPLETAR
MAIL_PORT=587
MAIL_USER=COMPLETAR
MAIL_PASS=COMPLETAR
MAIL_FROM=COMPLETAR

# ---- Alta publica de instituciones ----
# Cerrada: se abre un momento para crear una institucion, y se vuelve a cerrar.
ALTA_PUBLICA=false

# ---- Memoria ----
# Para un servidor de 8 GB. Con 4 GB: MEMORIA_APP=2500m y MEMORIA_DB=700m.
MEMORIA_APP=5g
MEMORIA_DB=1g
# Opciones extra de la JVM. Vacio en un servidor comun.
JAVA_OPCIONES=
#
# EN ORACLE ALWAYS FREE (2 OCPU, 12 GB), usar estos tres valores:
#   MEMORIA_APP=9g
#   MEMORIA_DB=2g
#   JAVA_OPCIONES=-XX:InitialRAMPercentage=40 -XX:+AlwaysPreTouch
# Oracle reclama una instancia si durante 7 dias tiene CPU, red y memoria por debajo del 20 %. Un
# sistema de asistencia pasa la noche y el fin de semana sin hacer nada, y la memoria es la unica de
# las tres que se puede sostener: AlwaysPreTouch reserva el heap entero desde el arranque.

# ---- Secretos ----
# Los completa generar-secretos.sh.
#
# BIOMETRIA_CLAVE y BIOMETRIA_SALT cifran los modelos faciales. SI SE PIERDEN, O SI SE CAMBIAN,
# LOS MODELOS QUEDAN ILEGIBLES y hay que registrar todos los rostros de nuevo. Guardar una copia
# fuera del servidor, y NUNCA junto con los respaldos: los dos juntos alcanzan para leerlo todo.
DB_ROOT_PASSWORD=GENERAR
DB_PASSWORD=GENERAR
BIOMETRIA_CLAVE=GENERAR
BIOMETRIA_SALT=GENERAR
