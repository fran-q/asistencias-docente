@startuml casos-de-uso
title Sistema de Asistencias Digital con Reconocimiento Facial\nDiagrama de Casos de Uso

skinparam actorStyle awesome
skinparam usecaseBackgroundColor #f0f0f0
skinparam packageStyle rectangle
left to right direction

actor "Administrador\nInstitución\n(rol INSTITUCION)" as Insti
actor "Administrador\noperativo\n(rol ADMIN)" as Admin
actor Docente
actor "Sistema de\nReconocimiento\n(JavaCV + LBPH)" as Sys <<system>>

rectangle "Sistema de Asistencias" {

  package "Gestión de la institución" {
    usecase "Editar datos\nde la institución" as UC_INST
    usecase "Crear y dar de\nbaja administradores" as UC_USR
  }

  package "Gestión académica" {
    usecase "Gestionar carreras" as UC_CAR
    usecase "Gestionar materias\n(asignar titular)" as UC_MAT
    usecase "Gestionar comisiones\n(asignar docente)" as UC_COM
    usecase "Gestionar horarios\n(con tolerancia)" as UC_HOR
    usecase "Ver grilla semanal\npor carrera" as UC_GRI
  }

  package "Docentes y biometría" {
    usecase "Gestionar docentes" as UC_DOC
    usecase "Cargar consentimiento\nbiométrico (Ley 25.326)" as UC_CON
    usecase "Revocar consentimiento" as UC_REV
    usecase "Registrar rostro\n(grabación 30 s)" as UC_REG
    usecase "Re-registrar rostro\n(da de baja el anterior)" as UC_RER
  }

  package "Asistencia" {
    usecase "Pasar asistencia\nautomática" as UC_PASE
    usecase "Identificar rostro\ny marcar" as UC_IDEN
    usecase "Cargar asistencia\nmanual con motivo" as UC_MAN
    usecase "Justificar ausencia" as UC_JUS
    usecase "Ver listado de\nasistencias del día" as UC_LIST
    usecase "Exportar reporte CSV" as UC_REP
  }
}

' === Permisos por rol ===
Insti --> UC_INST
Insti --> UC_USR

Insti --> UC_CAR
Admin --> UC_CAR
Insti --> UC_MAT
Admin --> UC_MAT
Insti --> UC_COM
Admin --> UC_COM
Insti --> UC_HOR
Admin --> UC_HOR
Insti --> UC_GRI
Admin --> UC_GRI

Insti --> UC_DOC
Admin --> UC_DOC
Insti --> UC_CON
Admin --> UC_CON
Insti --> UC_REV
Admin --> UC_REV
Insti --> UC_REG
Admin --> UC_REG
Insti --> UC_RER
Admin --> UC_RER

Insti --> UC_PASE
Admin --> UC_PASE
Insti --> UC_MAN
Admin --> UC_MAN
Insti --> UC_JUS
Admin --> UC_JUS
Insti --> UC_LIST
Admin --> UC_LIST
Insti --> UC_REP
Admin --> UC_REP

' === Docente: sujeto pasivo (no se loguea, solo se le toma asistencia) ===
Docente .. UC_PASE : presenta su rostro

' === Sistema interno ===
UC_PASE ..> UC_IDEN : <<include>>
UC_IDEN <-- Sys : ejecuta LBPH

' === Dependencias funcionales (extend / include) ===
UC_REG ..> UC_CON : <<requires>>\nconsentimiento ACTIVO
UC_PASE ..> UC_REG : <<requires>>\nmodelo facial activo
UC_JUS  ..> UC_MAN : <<requires>>\nasistencia AUSENTE persistida

@enduml
